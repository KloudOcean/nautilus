# Nautilus — example environment file. Copy to .env and fill in real values.

# Gateway auth
GATEWAY_KEY=change-me-in-production

# Provider toggles
NAUTILUS_CLAUDE_ENABLED=true
NAUTILUS_OPENAI_ENABLED=false

# Provider API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database (for v0.2 semantic cache)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nautilus
POSTGRES_USER=nautilus
POSTGRES_PASSWORD=nautilus

# Redis (for v0.2 rate limits and cache)
REDIS_HOST=redis
REDIS_PORT=6379
